<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Új termék felvétele</h1>

    <a href="/index">Főoldal</a><br>
    <a href="/filter">Filter</a><br>

    <form>
        <label for="name">Adja meg a termék nevét</label><br>
        <input type="text" id="name"><br>
        <label for="category">Válassza ki a kategóriát</label><br>
        <select name="category">
            <option value="elektronika">elektronika</option>
            <option value="ruházat">ruházat</option>
            <option value="könyv">könyv</option>
            <option value="játék">játék</option>
        </select><br>
        <label for="price">Adja meg a termék árát</label><br>
        <input type="number" id="price"><br>
        <label for="stock">Adja meg mennyi van belőle raktáron</label><br>
        <input type="number" id="stock">

        <button type="submit">Hozzáad</button>

    </form>
</body>
</html>